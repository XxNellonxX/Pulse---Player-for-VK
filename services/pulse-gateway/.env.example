# SERVER ONLY. Never copy this file or its real credentials into an EXE/release.
PULSE_DOMAIN=music-api.example.com
PUBLIC_ORIGIN=https://music-api.example.com
ACME_EMAIL=admin@example.com
SOUNDCLOUD_CLIENT_ID=PASTE_REAL_SERVER_CLIENT_ID
SOUNDCLOUD_CLIENT_SECRET=PASTE_REAL_SERVER_CLIENT_SECRET
MUSICBRAINZ_USER_AGENT=PulseGateway/1.0 (mailto:admin@example.com)

# Public service abuse caps: these do not make a bundled desktop token secret.
MAX_GLOBAL_CONCURRENT=16
MAX_IP_CONCURRENT=6
METADATA_PER_IP_MINUTE=60
MEDIA_PER_IP_MINUTE=600
GLOBAL_REQUESTS_MINUTE=6000
